{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "preset": "recommended" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "files": { "ignoreUnknown": true, "includes": ["src/**", "*.ts", "*.mjs"] }
}
